"c100_guide_media_sync_p1" = "Please open INMO Moment APP, tap \"Sync\" on the \"Home\" or \"Gallery\" page, and the glasses will automatically transfer photos and videos to your phone via Wi-Fi.";
"c100_guide_media_sync_title" = "How to sync captured photos and videos to INMO Moment APP?";
"c100_guide_second_bt_device_p1" = "While not wearing the glasses, press the \"Function Button\" 7 times consecutively to unpair current Bluetooth until the inner indicator light turns solid blue.\n\nAfter a moment, the inner indicator light flashes blue, indicating the glasses are entering pairing mode.\n\nOpen \"Choose Product\" page, select \"inmo Moment Max\", and follow on-screen instructions to complete search and binding.";
"c100_guide_second_bt_device_title" = "How to connect a second Bluetooth device?";
"c100_guide_title" = "Beginner's Guide";
"c100_guide_unbind_h1" = "Unbind when connected (Strongly recommended):";
"c100_guide_unbind_h2" = "Unbind when disconnected:";
"c100_guide_unbind_h3" = "Please note, to ensure smooth connection next time, you also need to remove the glasses' pairing information from your phone's system Bluetooth list after unbinding.";
"c100_guide_unbind_p1" = "Open INMO Moment App, go to \"Settings\" - tap \"Unbind Glasses\". After successful unbinding, the glasses will automatically return to Bluetooth pairing mode (indicator light flashes blue).";
"c100_guide_unbind_p2" = "Open INMO Moment App, go to \"Settings\" - tap \"Unbind Glasses\". This operation only removes the glasses from INMO Moment App; the glasses themselves are not unbound. If you need to bind the glasses to another phone or account, you must manually unbind the glasses (refer to connecting a second Bluetooth device) or restore factory settings (refer to glasses reset instructions).";
"c100_guide_unbind_p3" = "iOS users: Go to \"Settings\" - \"Bluetooth\", find your glasses in the device list, tap it and select \"Forget This Device\".\nAndroid users: Some Android phones will clear automatically, but we still recommend checking Bluetooth settings and manually deleting or forgetting this device.";
"c100_guide_unbind_title" = "How to unbind the glasses?";

